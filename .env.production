# API Configuration
VITE_API_BASE_URL=https://dummyjson.com
VITE_SQL_OPTIMIZER_API_BASE_URL=https://beta26.moonbeta.com

# Application Configuration
VITE_APP_NAME=ReactKit
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=production

# Token Configuration
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_TOKEN_EXPIRY_KEY=token_expiry

# Feature Flags
VITE_ENABLE_REFRESH_TOKEN=true
VITE_ENABLE_ROLE_BASED_ACCESS=true

# Debug
VITE_API_LOGGING=false