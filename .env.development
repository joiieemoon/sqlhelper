# API Configuration
VITE_API_BASE_URL=https://dummyjson.com
# Talk to the backend running on this machine directly.
# The dev tunnel (https://nv8vvk50-8000.inc1.devtunnels.ms) is NOT used here:
# /db_optimize_full runs the full LLM pipeline and takes ~1-2 minutes, and the
# tunnel drops long-lived requests, so the browser saw a generic network failure
# even though the backend had returned 200. Switch back only when you actually
# need to reach this API from another device.
# VITE_SQL_OPTIMIZER_API_BASE_URL=http://127.0.0.1:8000
VITE_SQL_OPTIMIZER_API_BASE_URL=http://localhost:8000
VITE_SQL_OPTIMIZER_TIMEOUT_MS=4200000

# Application Configuration
VITE_APP_NAME=ReactKit
VITE_APP_VERSION=1.0.0-dev

# Environment
VITE_NODE_ENV=development

# Token Configuration
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_TOKEN_EXPIRY_KEY=token_expiry

# Feature Flags
VITE_ENABLE_REFRESH_TOKEN=true
VITE_ENABLE_ROLE_BASED_ACCESS=true

# Debug
VITE_API_LOGGING=true