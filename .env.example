# ============================================================
#  SQL Optimizer — environment template
#  Copy to .env and fill in real values.  NEVER commit .env.
# ============================================================

# ── LLM: Gemini via Vertex AI (primary provider) ────────────
# Path to the Google service-account JSON private key.
# NEVER commit the real key file — it lives only on this machine.
GEMINI_SA_FILE=./fish-store-PROJECTNUMBER-HASH.json

# GCP project id (from the service account / console)
GEMINI_PROJECT=your-gcp-project-id

# Vertex AI region + model
GEMINI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Per-call timeout (seconds), 429 retry count, pacing between calls
GEMINI_TIMEOUT=120
GEMINI_MAX_429_RETRIES=5
GEMINI_INTERCALL_GAP=1.0
GEMINI_STAGE_PAUSE_SECONDS=0

# ── Legacy Groq (unused — key removed; kept for fallback) ───
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STAGE_PAUSE_SECONDS=0

# ── Pipeline timeout ────────────────────────────────────────
LLM_TIMEOUT_SECONDS=300

# ── R&D: Direct MySQL connection (optional dev fallbacks) ───
# The web app sends connection details per-request; these DB_* vars are
# only used as fallbacks when a request field is omitted/placeholder.
# NEVER commit the real password — fill it in .env only (gitignored).
DB_HOST=mysql-sql-optimizer-test01-sql-optimizer-test01.l.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=#REMOVED_PASSWORD
DB_NAME=defaultdb
DB_CONNECT_TIMEOUT=10
