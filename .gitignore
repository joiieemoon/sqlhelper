# Environment files (contain GROQ_API_KEY and LLM config)
.env
.env.*
*.env
env

# Template is allowed
!.env.example

# Google Cloud / Vertex AI service-account private keys
fish-store-488312-4164e0ad13ad.json
fish-store-*.json
*service*account*.json
*-sa-*.json
*sa-key*.json
*credentials*.json

# Any other key material
*.pem
*.key
*.p12
*.pfx
id_rsa*

# ══════════════════════════════════════════════════════════════
