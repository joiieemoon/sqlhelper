# ══════════════════════════════════════════════════════════════
node_modules/
package-lock.json

# ══════════════════════════════════════════════════════════════
#  RUNTIME ARTIFACTS & LOGS
# ══════════════════════════════════════════════════════════════

# Rate-limit SQLite DB (+ WAL/SHM sidecars) — per-machine state
rate_limit.db
rate_limit.db-shm
rate_limit.db-wal
*.db-shm
*.db-wal
*.sqlite3
*.sqlite3-journal

# Logs
*.log
*.log.*
logs/

# Crash dumps / temp
*.dmp
*.tmp
*.bak

# ══════════════════════════════════════════════════════════════
#  LOCAL TOOLING / IDE / OS
# ══════════════════════════════════════════════════════════════
.vscode/
.idea/
.aidlc/
.dist/
.cursor/
.claude/
.DS_Store
Thumbs.db
desktop.ini

